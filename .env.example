# FL Studio Web Clone — Production Environment Variables

# App Environment: development | production
ENVIRONMENT=production

# Server Port (Render automatically supplies PORT)
PORT=8000

# Secret Key for sessions and security tokens (generate with: openssl rand -hex 32)
SECRET_KEY=fl_studio_production_secret_key_change_me_in_prod

# Super Admin Default Seed (Rahul Sharma)
ADMIN_USERNAME=rahul
ADMIN_EMAIL=rahul@flstudio.local
ADMIN_PASSWORD=password123
ADMIN_FULL_NAME=Rahul Sharma

# Optional AI Music Generation Key (Hugging Face)
# Set your token here to keep it hidden on the server; the frontend will proxy through the backend
HF_TOKEN=

# Database Connection (Leave empty for local embedded SQLite, or supply Postgres connection string)
DATABASE_URL=
